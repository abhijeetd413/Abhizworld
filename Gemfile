source "https://rubygems.org"

# Use Jekyll directly instead of github-pages
gem "jekyll", "~> 4.3.3"

# Theme
gem "minimal-mistakes-jekyll"

# Windows support
gem "tzinfo-data"
gem "wdm", "~> 0.1.0" if Gem.win_platform?

# Plugins
group :jekyll_plugins do
  gem "jekyll-paginate"
  gem "jekyll-sitemap"
  gem "jekyll-gist"
  gem "jekyll-feed"
  gem "jemoji"
  gem "jekyll-include-cache"
  gem "jekyll-algolia"
end
